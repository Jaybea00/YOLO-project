# ─── Copy this file to .env and fill in your keys ────────────────────────────

# Required: at least one LLM provider
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here        # optional fallback

# Optional: Roboflow for cloud YOLO inference
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=your_workspace/model-name/version

# Optional: Moondream cloud API (leave blank to run locally)
MOONDREAM_API_KEY=

# ── Stream Video (getstream.io) ────────────────────────────────────────────────
# Get your keys at https://dashboard.getstream.io → create an app → Video & Audio
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# Server config
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# YOLO model — yolov8n.pt | yolov8s.pt | yolov8m.pt | yolov8l.pt | yolov8x.pt
YOLO_MODEL=yolov8s.pt
YOLO_CONFIDENCE=0.20
YOLO_IOU=0.45

# LLM provider — gemini | openai
LLM_PROVIDER=gemini
