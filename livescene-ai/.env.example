# ─── Frontend environment variables ──────────────────────────────────────────
# Copy this file to .env.local and adjust as needed.

# Backend URLs
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000/ws/stream

# Set to "false" to use the real Python backend instead of mock data
# Requires the Python backend to be running first
VITE_MOCK_BACKEND=true
